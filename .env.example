# DEMANDA VIVA — variáveis públicas do frontend (Vite)
# Copie para .env.local se for testar Supabase localmente.
# NUNCA coloque service_role, sb_secret_*, connection string ou senhas aqui.
# Qualquer VITE_* entra no bundle público do browser.

# Deixe AMBAS vazias para o MVP demonstrativo local-only
# (remoteSharingEnabled=false; banner "Modo offline").
# No Cloudflare Pages do release estático: NÃO configurar estas variáveis.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
