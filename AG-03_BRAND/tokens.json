    "conditionalBg": "#FEF3C7",
    "ineligibleText": "#991B1B",
    "ineligibleBg": "#FEF2F2",
    "insufficientText": "#075985",
    "insufficientBg": "#E0F2FE",
    "processingText": "#475569",
