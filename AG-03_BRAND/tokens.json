{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "DEMANDA VIVA — Ponte Viva",
  "version": "1.0.0-proposal",
  "status": "Proposta AG-03; aprovação pela equipe pendente",
  "color": {
    "ink": "#11273A",
    "primary": "#075E6B",
    "primaryHover": "#064C58",
    "accent": "#25BAA7",
    "background": "#F7FAFC",
    "surface": "#FFFFFF",
    "text": "#11273A",
    "textMuted": "#52687A",
    "border": "#748D9B",
    "borderSubtle": "#C6D5DD",
    "focus": "#075E6B",
